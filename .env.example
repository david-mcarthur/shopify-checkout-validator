# Shopify App Credentials
# Get these from Shopify Dev Dashboard > App > Settings
SHOPIFY_API_KEY="your-api-key-here"
SHOPIFY_API_SECRET="your-api-secret-here"
SCOPES=""

# Set by Shopify CLI during `shopify app dev`
SHOPIFY_APP_URL="https://your-tunnel-url.trycloudflare.com"

# SQLite database (local dev)
DATABASE_URL="file:dev.sqlite"
